# =====================================================
# VHF Tienda — Variables de entorno
# Configurá estas vars en Vercel → Settings → Environment Variables
# =====================================================

# --- Supabase (DB) ---
# Las obtenés en Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://bzvfydkqpkcqfnuuyagt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # ¡Solo en el servidor! Nunca exponer al navegador.

# --- Admin login ---
# Email y contraseña para entrar a /admin
ADMIN_EMAIL=victor@vhfbelen.com.ar
ADMIN_PASSWORD=<contraseña fuerte de al menos 16 caracteres>

# --- JWT secret ---
# Cadena aleatoria larga (mínimo 32 caracteres). Generala con:
#   openssl rand -base64 48
ADMIN_JWT_SECRET=<cadena larga aleatoria>
