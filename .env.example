# =====================================================
# VHF Tienda — Variables de entorno
# =====================================================
# La URL de Supabase y la anon key vienen con defaults
# bakeados en lib/publicSupabase.ts (son claves PÚBLICAS
# por diseño, viajan al navegador). Solo necesitás
# setear las 3 SECRETAS abajo.
#
# Si querés usar OTRO proyecto Supabase (no el default),
# seteá NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_ANON_KEY
# para sobrescribir.
# =====================================================

# --- 🔒 Service role key de Supabase (OBLIGATORIA) ---
# Supabase → Settings → API → service_role. Es secreta — NUNCA exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- 🔒 Login del admin (OBLIGATORIAS) ---
ADMIN_EMAIL=victorhugo@vhfbelen.com.ar
ADMIN_PASSWORD=<contraseña fuerte de al menos 12 caracteres>

# --- 🔒 JWT secret (OBLIGATORIA) ---
# Generala con:  openssl rand -base64 48
ADMIN_JWT_SECRET=<cadena aleatoria de al menos 32 caracteres>

# --- (opcional) override de la DB pública ---
# NEXT_PUBLIC_SUPABASE_URL=https://otro-proyecto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
